<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EV Radar — {{ run_date }}</title>
<style>
:root {
  --bg: #f4f6f8; --card: #ffffff; --text: #1c2430; --muted: #66727f; --line: #e2e7ec;
  --accent: #2563eb; --new: #16a34a; --new-bg: #e7f7ed; --drop: #d97706; --drop-bg: #fff3dc;
  --err: #dc2626; --err-bg: #fde8e8; --warn-bg: #fff3dc; --chip: #eef1f5;
  --shadow: 0 1px 2px rgba(16,24,40,.06), 0 2px 8px rgba(16,24,40,.05);
  --radius: 12px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0f141a; --card: #171e27; --text: #e6ebf0; --muted: #93a0ae; --line: #263140;
    --accent: #6ea0ff; --new: #4ade80; --new-bg: #12301f; --drop: #fbbf24; --drop-bg: #3a2c0b;
    --err: #f87171; --err-bg: #3b1717; --warn-bg: #3a2c0b; --chip: #1f2833;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 2px 10px rgba(0,0,0,.3);
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
a { color: var(--accent); text-decoration: none; }
main { max-width: 1280px; margin: 0 auto; padding: 20px 16px 60px; }
h1 { font-size: 1.6rem; margin: 0; letter-spacing: -.02em; }
h2 { font-size: 1.15rem; margin: 34px 0 12px; display: flex; align-items: center; gap: 8px; }
h2 .count { font-size: .8rem; color: var(--muted); font-weight: 500; background: var(--chip);
  padding: 2px 9px; border-radius: 99px; }
small, .muted { color: var(--muted); }
.sub { color: var(--muted); margin-top: 4px; }
.banner { background: var(--warn-bg); border-radius: var(--radius); padding: 10px 14px; margin-top: 12px; }
.banner.alert { background: var(--err-bg); color: var(--err); }
.banner[hidden] { display: none; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-top: 16px; }
.stat { background: var(--card); border-radius: var(--radius); padding: 12px 14px; box-shadow: var(--shadow); }
.stat b { display: block; font-size: 1.6rem; line-height: 1.1; letter-spacing: -.02em; }
.stat span { color: var(--muted); font-size: .82rem; }
.stat.new b { color: var(--new); } .stat.drop b { color: var(--drop); }

.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
.tile { background: var(--card); border-radius: var(--radius); padding: 10px 12px; box-shadow: var(--shadow);
  border-left: 4px solid var(--new); }
.tile.ERROR { border-color: var(--err); } .tile.SKIPPED { border-color: var(--muted); }
.tile.STALE { border-color: var(--drop); }
.tile .name { font-weight: 600; display: flex; justify-content: space-between; gap: 6px; }
.tile .meta { color: var(--muted); font-size: .82rem; margin-top: 2px; }
.tile .msg { font-size: .78rem; margin-top: 4px; color: var(--muted); word-break: break-word; }
.st { font-size: .68rem; font-weight: 700; padding: 2px 7px; border-radius: 99px; background: var(--new-bg); color: var(--new);
  white-space: nowrap; align-self: flex-start; }
.ERROR .st { background: var(--err-bg); color: var(--err); }
.STALE .st { background: var(--drop-bg); color: var(--drop); }
.SKIPPED .st { background: var(--chip); color: var(--muted); }

.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 14px; }
.card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden;
  display: flex; flex-direction: column; break-inside: avoid; }
.card.is-new { box-shadow: var(--shadow), inset 0 3px 0 var(--new); }
.card.is-drop { box-shadow: var(--shadow), inset 0 3px 0 var(--drop); }
.thumb { aspect-ratio: 16 / 10; background: var(--chip); display: flex; align-items: center; justify-content: center;
  color: var(--muted); font-size: .8rem; }
.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.ttl { font-weight: 650; font-size: 1.02rem; letter-spacing: -.01em; }
.raw { color: var(--muted); font-size: .8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.facts { display: flex; flex-wrap: wrap; gap: 4px 12px; color: var(--muted); font-size: .86rem; }
.price { font-size: 1.3rem; font-weight: 700; letter-spacing: -.02em; }
.price small { font-size: .72rem; font-weight: 500; }
.old { text-decoration: line-through; color: var(--muted); font-size: .95rem; margin-right: 6px; }
.delta { font-weight: 650; color: var(--drop); background: var(--drop-bg); padding: 1px 8px; border-radius: 99px; font-size: .82rem; }
.delta.up { color: var(--err); background: var(--err-bg); }
.row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 8px; }
.badge { font-size: .72rem; font-weight: 600; padding: 2px 8px; border-radius: 99px; background: var(--chip); color: var(--muted); }
.badge.new { background: var(--new-bg); color: var(--new); }
.badge.drop { background: var(--drop-bg); color: var(--drop); }
.badge.warn { background: var(--warn-bg); color: var(--drop); }
.btn { display: inline-block; padding: 6px 12px; border-radius: 8px; background: var(--accent); color: #fff; font-weight: 600; font-size: .85rem; }
.btn:hover { filter: brightness(1.1); }
.empty { color: var(--muted); padding: 14px; background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); }

.toolbar { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.toolbar input[type=search] { width: 100%; max-width: 420px; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line);
  background: var(--card); color: var(--text); font: inherit; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.chips .lbl { font-size: .78rem; color: var(--muted); min-width: 52px; }
.chip { border: 1px solid var(--line); background: var(--chip); color: var(--text); padding: 3px 11px; border-radius: 99px;
  font: inherit; font-size: .82rem; cursor: pointer; }
.chip[aria-pressed=true] { background: var(--accent); border-color: var(--accent); color: #fff; }
.chip i { font-style: normal; opacity: .65; margin-left: 4px; }
.tbl-wrap { overflow-x: auto; background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); }
table { border-collapse: collapse; width: 100%; font-size: .9rem; }
th, td { padding: 9px 12px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
td.wrap { white-space: normal; min-width: 220px; }
.veh { display: flex; align-items: center; gap: 10px; }
.mini { flex: none; width: 56px; height: 40px; border-radius: 6px; overflow: hidden; background: var(--chip); display: block; }
.mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
.spark { vertical-align: middle; margin-left: 8px; color: var(--muted); }
.spark polyline { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
.spark circle { fill: currentColor; }
.spark.down { color: var(--new); }
.spark.up { color: var(--err); }
.mkt { font-size: .78rem; font-weight: 650; padding: 2px 8px; border-radius: 99px; background: var(--chip); color: var(--muted); }
.mkt.deal { background: var(--new-bg); color: var(--new); }
.mkt.pricey { background: var(--err-bg); color: var(--err); }
.btn:visited { background: var(--muted); }
.act { display: flex; align-items: center; gap: 6px; }
.ico { border: 1px solid var(--line); background: var(--chip); color: var(--muted); border-radius: 8px; width: 30px; height: 30px;
  font-size: 1rem; line-height: 1; cursor: pointer; padding: 0; }
.ico:hover { color: var(--text); }
tr.fav .ico.star { color: #f59e0b; border-color: #f59e0b; }
tr.dismissed { opacity: .5; }
.toggles { display: flex; flex-wrap: wrap; gap: 6px; }
.bars { display: block; margin-top: 6px; }
td.srcs { white-space: normal; max-width: 200px; }
td.srcs .badge { display: inline-block; margin: 0 4px 4px 0; color: var(--muted); }
td.srcs a.badge:hover { color: var(--accent); }
td.srcs .dup { font-weight: 700; color: var(--drop); margin-left: 2px; }
.bars rect { fill: var(--new); } .bars rect.err { fill: var(--err); } .bars rect.stale { fill: var(--drop); }
.bars rect.skip { fill: var(--line); }
.badge.soh { background: var(--new-bg); color: var(--new); }
.ranges { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; }
.ranges label { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--muted); }
.ranges output { color: var(--text); font-weight: 650; min-width: 74px; }
.ranges input[type=range] { width: 150px; accent-color: var(--accent); }
table.trend td.up { color: var(--err); } table.trend td.down { color: var(--new); }
.deps { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 640px), 1fr)); gap: 14px; }
.dep { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 12px 14px; }
.dep h3 { margin: 0 0 4px; font-size: 1rem; }
.dep .fit { margin: 0 0 8px; font-size: .88rem; }
.dep-body { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; }
.scatter { flex: none; max-width: 100%; }
.scatter .frame { fill: none; stroke: var(--line); }
table.yrs { width: auto; font-size: .82rem; }
table.yrs td.up { color: var(--err); } table.yrs td.down { color: var(--new); }
.dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
th { position: sticky; top: 0; background: var(--card); cursor: pointer; user-select: none; font-size: .78rem;
  text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
th[aria-sort=ascending]::after { content: " ▲"; } th[aria-sort=descending]::after { content: " ▼"; }
th.nosort { cursor: default; }
tr:last-child td { border-bottom: 0; }
td.num, th.num { text-align: right; }
tr.hidden { display: none; }
details { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 4px 14px; }
details summary { cursor: pointer; padding: 10px 0; font-weight: 600; }
footer { margin-top: 40px; color: var(--muted); font-size: .8rem; text-align: center; }

@media (max-width: 640px) {
  h1 { font-size: 1.3rem; } .stat b { font-size: 1.3rem; }
  .cards { grid-template-columns: 1fr; }
}
@media print {
  :root { --bg: #fff; --card: #fff; --text: #000; --shadow: none; --line: #ccc; }
  body { font-size: 11px; } .toolbar, .btn { display: none; }
  .card { border: 1px solid #ccc; } .cards { grid-template-columns: repeat(3, 1fr); }
  details { box-shadow: none; } details > * { display: block; }
  .tbl-wrap { overflow: visible; } th { position: static; } tr.hidden { display: table-row; }
  h2 { break-after: avoid; }
}
</style>
</head>
<body>
{% macro price(o) -%}
  {%- if o.price_gross_pln is not none -%}
    {{ o.price_gross_pln|pln }} <small>brutto</small>
    {%- if o.price_net_pln is not none %} <small>· {{ o.price_net_pln|pln }} netto</small>{% endif -%}
  {%- elif o.price_net_pln is not none -%}
    {{ o.price_net_pln|pln }} <small>netto</small>
  {%- else -%}<span class="muted">brak ceny</span>{%- endif -%}
{%- endmacro %}

{% macro basis(b) -%}{{ 'netto' if b == 'net' else 'brutto' }}{%- endmacro %}

{% macro thead() %}
<thead><tr>
  <th data-type="text">Pojazd</th><th data-type="num" class="num">Rok</th>
  <th data-type="num" class="num">Przebieg</th><th data-type="num" class="num">Cena</th>
  <th data-type="num" class="num" title="Cena brutto względem mediany porównywalnych ofert">Vs rynek</th>
  <th data-type="text">Źródło</th>
  <th data-type="text">Widziana od</th><th data-type="num" class="num" title="Dni od daty dodania ogłoszenia (a gdy jej brak — od pierwszego skanu)">W ofercie</th><th class="nosort"></th>
</tr></thead>
{% endmacro %}

{% macro offer_row(o, diff=none) %}
<tr data-id="{{ o.offer_id }}" data-brand="{{ o.brand }}" data-model="{{ o.brand }} {{ o.model_matched }}" data-source="{{ source_names.get(o.source, o.source) }}" data-source-all="{{ offer_sources(o)|join('|') }}"
    data-year="{{ o.year or '' }}" data-km="{{ o.mileage_km if o.mileage_km is not none else '' }}" data-gross="{{ o.price_gross_pln or '' }}" data-net="{{ o.price_net_pln or '' }}"
    data-seller="{{ seller_labels.get(o.seller_type, '') }}"
    data-search="{{ (o.brand ~ ' ' ~ o.model_matched ~ ' ' ~ o.title_raw ~ ' ' ~ (o.location or '') ~ ' ' ~ offer_sources(o)|join(' '))|lower }}">
  <td class="wrap" data-s="{{ o.brand }} {{ o.model_matched }}">
    <div class="veh">
      <a class="mini" href="{{ o.url }}" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">{% if o.image_url %}<img src="{{ o.image_url }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">{% endif %}</a>
      <div>
        <b>{{ o.brand }} {{ o.model_matched }}</b>
        {% if o.offer_id in new_ids %}<span class="badge new">NOWA</span>{% endif %}
        {% if o.offer_id in drop_ids %}<span class="badge drop">OBNIŻKA</span>{% endif %}
        {% if o.uncertain_powertrain %}<span class="badge warn">⚠ napęd do weryfikacji</span>{% endif %}
        <br><small>{{ o.title_raw }}{% if o.location %} · {{ o.location }}{% endif %}</small>
        {% if o.seller_type or o.soh_pct or o.listed_at or o.battery_kwh or o.range_km_wltp %}<br>
          {% if o.seller_type %}<span class="badge">{{ seller_labels[o.seller_type] }}</span>{% endif %}
          {% if o.battery_kwh %}<span class="badge">{{ o.battery_kwh|round(1) }} kWh</span>{% endif %}
          {% if o.range_km_wltp %}<span class="badge" title="Zasięg WLTP z ogłoszenia lub z tabeli modeli (config/models.yaml)">{{ o.range_km_wltp }} km WLTP</span>{% endif %}
          {% if o.soh_pct %}<span class="badge soh" title="Stan zdrowia baterii z opisu ogłoszenia">SOH {{ o.soh_pct }}%</span>{% endif %}
          {% if o.listed_at %}<span class="badge" title="Data dodania ogłoszenia">dodano {{ o.listed_at|short_date }}</span>{% endif %}
        {% endif %}
      </div>
    </div>
  </td>
  <td class="num" data-s="{{ o.year or 0 }}">{{ o.year or '—' }}</td>
  <td class="num" data-s="{{ o.mileage_km if o.mileage_km is not none else -1 }}">{{ o.mileage_km|km if o.mileage_km is not none else '—' }}</td>
  <td class="num" data-s="{{ o.price_gross_pln or o.price_net_pln or 0 }}">
    {%- if diff and diff.old_price is not none and diff.new_price is not none -%}
      <span class="old">{{ diff.old_price|pln }}</span><b>{{ diff.new_price|pln }}</b> <small>{{ basis(diff.price_basis) }}</small><br>
      <span class="delta {{ 'up' if diff.delta > 0 else '' }}">{{ '%+d'|format(diff.delta)|replace('-', '−') }} zł
        {%- if diff.delta_pct is not none %} ({{ '%+.1f'|format(diff.delta_pct)|replace('-', '−') }}%){% endif %}</span>
    {%- else -%}
      {{ price(o) }}{{ spark(o.offer_id) }}
    {%- endif -%}
  </td>
  {% set m = market.get(o.offer_id) %}
  <td class="num" data-s="{{ m.pct|round(1) if m else 999 }}">{% if m %}<span class="mkt {{ 'deal' if m.pct <= -10 else 'pricey' if m.pct >= 10 else '' }}" title="Mediana {{ m.median|pln }} ({{ m.n }} ofert, porównanie: {{ m.scope }})">{{ '%+.0f'|format(m.pct)|replace('-', '−') }}%</span>{% else %}<span class="muted" title="Za mało ofert do porównania">—</span>{% endif %}</td>
  <td data-s="{{ source_names.get(o.source, o.source) }}" class="srcs">
    <a class="badge" href="{{ o.url }}" target="_blank" rel="noopener noreferrer">{{ source_names.get(o.source, o.source) }}</a>
    {% for l in o.also_on %}<a class="badge" href="{{ l.url }}" target="_blank" rel="noopener noreferrer" title="To samo auto (VIN lub zgodne parametry){% if l.price_gross_pln %} — {{ l.price_gross_pln|pln }} brutto{% endif %}">{{ source_names.get(l.source, l.source) }}{% if l.vin_match %} <small class="dup">Duplikat</small>{% endif %}</a>{% endfor %}
  </td>
  <td data-s="{{ o.first_seen_at.isoformat() }}">{{ o.first_seen_at|short_date }}</td>
  {% set a = age(o) %}
  <td class="num" data-s="{{ a[0] }}" title="{{ 'Od daty dodania ogłoszenia' if a[1] else 'Od pierwszego skanu (ogłoszenie mogło być starsze)' }}">{{ a[0] }} d{{ '' if a[1] else '+' }}</td>
  <td><div class="act">
    <button type="button" class="ico star" data-act="fav" title="Obserwuj" aria-label="Obserwuj">★</button>
    <button type="button" class="ico" data-act="hide" title="Ukryj / przywróć" aria-label="Ukryj">✕</button>
    <a class="btn" href="{{ o.url }}" target="_blank" rel="noopener noreferrer">Oferta ↗</a>
  </div></td>
</tr>
{% endmacro %}

{% macro offers_section(diffs) %}
<div class="tbl-wrap"><table class="offers">
  {{ thead() }}
  <tbody>{% for x in diffs %}{{ offer_row(x.offer, x if x.old_price is not none else none) }}{% endfor %}</tbody>
</table></div>
{% endmacro %}

<main>
  <header>
    <h1>⚡ EV Radar</h1>
    <div class="sub">Skan: {{ run_date }}, {{ run_time }} · czas trwania {{ d.run.duration_s|round(1) }} s
      {% if d.run.run_id %}· przebieg #{{ d.run.run_id }}{% endif %}</div>
    {% if d.run.dry_run %}<div class="banner">Tryb <b>dry-run</b>: wyniki nie zostały zapisane w bazie.</div>{% endif %}
    {% if first_run %}<div class="banner">To pierwszy skan — wszystkie oferty są oznaczone jako nowe.</div>{% endif %}
    {% if problems %}<div class="banner alert" role="alert">⚠ Problem ze źródłami: {% for s in problems %}<b>{{ s.name or s.source }}</b> ({{ 'błąd' if s.status.value == 'ERROR' else 'brak ofert' }}){{ ', ' if not loop.last }}{% endfor %}. Oferty z tych źródeł pochodzą z poprzedniego skanu.</div>{% endif %}
    <div class="banner alert" id="stale" role="alert" hidden data-run="{{ run_iso }}"></div>
    <div class="stats">
      <div class="stat"><b>{{ d.active|length }}</b><span>aktywnych ofert</span></div>
      <div class="stat new"><b>{{ d.new|length }}</b><span>nowych</span></div>
      <div class="stat drop"><b>{{ d.price_drops|length }}</b><span>obniżek cen</span></div>
      <div class="stat"><b>{{ d.gone|length }}</b><span>zniknęło</span></div>
      <div class="stat"><b>{{ ok_count }}/{{ d.sources|length }}</b><span>źródeł OK</span></div>
    </div>
  </header>

  <h2>Status źródeł</h2>
  <section class="tiles">
    {% for s in d.sources %}
    <div class="tile {{ s.status.value }}">
      <div class="name"><span>{{ s.name or s.source }}</span>
        <span class="st">{{ {'OK': 'OK', 'ERROR': 'BŁĄD', 'SKIPPED': 'POMINIĘTE', 'STALE': 'DO AKTUALIZACJI'}[s.status.value] }}</span></div>
      <div class="meta">{{ s.offers_count }} ofert · {{ s.duration_s|round(1) }} s</div>
      {% if s.status.value == 'STALE' %}<div class="msg">Źródło wymaga aktualizacji — parser nie zwrócił ofert (zmiana struktury strony?).</div>{% endif %}
      {% if s.note %}<div class="msg">{{ s.note }}</div>{% endif %}
      {% if s.error %}<div class="msg">{{ s.error[:200] }}</div>{% endif %}
      {% set h = health.get(s.source) %}
      {% if h %}{{ h.bars }}
        {% if h.verdict == 'drop' %}<div class="msg">⚠ Podejrzany spadek liczby ofert (zwykle ok. {{ h.ref }}).</div>{% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </section>

  <h2>🆕 Nowe oferty <span class="count">{{ d.new|length }}</span></h2>
  {% if d.new %}
  {{ offers_section(d.new) }}
  {% else %}<div class="empty">Brak nowych ofert od ostatniego skanu.</div>{% endif %}

  <h2>📉 Obniżki cen <span class="count">{{ d.price_drops|length }}</span></h2>
  {% if d.price_drops %}
  {{ offers_section(d.price_drops) }}
  {% else %}<div class="empty">Brak obniżek cen.</div>{% endif %}

  {% if d.back %}
  <h2>↩️ Wróciły do oferty <span class="count">{{ d.back|length }}</span></h2>
  {{ offers_section(d.back) }}
  {% endif %}

  {% if d.price_ups %}
  <h2>📈 Podwyżki cen <span class="count">{{ d.price_ups|length }}</span></h2>
  {{ offers_section(d.price_ups) }}
  {% endif %}

  <h2>Wszystkie aktywne oferty <span class="count" id="visible-count">{{ confirmed|length }}</span></h2>
  <div class="toolbar">
    <input type="search" id="q" placeholder="Szukaj: marka, model, miasto, tytuł…" aria-label="Szukaj">
    {% for group, label, items in chip_groups %}
    <div class="chips" data-group="{{ group }}"><span class="lbl">{{ label }}</span>
      {% for value, n in items %}<button type="button" class="chip" aria-pressed="false" data-value="{{ value }}">{{ value }}<i>{{ n }}</i></button>{% endfor %}
    </div>
    {% endfor %}
    <div class="ranges">
      <label>Cena do <input type="range" id="r-price" aria-label="Maksymalna cena"><output id="o-price"></output></label>
      <label>Przebieg do <input type="range" id="r-km" aria-label="Maksymalny przebieg"><output id="o-km"></output></label>
      <label>Rocznik od <input type="range" id="r-year" aria-label="Minimalny rocznik"><output id="o-year"></output></label>
      <button type="button" class="chip" id="reset-ranges">Wyczyść suwaki</button>
    </div>
    <div class="toggles">
      <button type="button" class="chip" id="only-fav" aria-pressed="false">★ Tylko obserwowane<i id="fav-count">0</i></button>
      <button type="button" class="chip" id="show-dismissed" aria-pressed="false">Pokaż ukryte<i id="dismissed-count">0</i></button>
    </div>
  </div>
  <div class="tbl-wrap">
    <table class="offers" id="offers">
      {{ thead() }}
      <tbody>
      {% for o in confirmed %}{{ offer_row(o) }}{% endfor %}
      </tbody>
    </table>
  </div>
  <div class="empty" id="no-match" hidden style="margin-top:10px">Brak ofert spełniających kryteria.</div>

  <h2>📊 Trend cen modeli</h2>
  {% if trend and trend|selectattr('change_pct', 'ne', none)|list %}
  <p class="sub" style="margin:-6px 0 12px">Mediana ceny brutto aktywnych ofert modelu w kolejnych dniach skanu (min. 3 oferty modelu).</p>
  <div class="tbl-wrap"><table class="trend">
    <thead><tr><th class="nosort">Model</th><th class="nosort num">Mediana</th><th class="nosort num">Ofert</th>
      <th class="nosort num">Zmiana</th><th class="nosort">Od</th><th class="nosort">Wykres</th></tr></thead>
    <tbody>
    {% for t in trend %}
      <tr><td><b>{{ t.model }}</b></td><td class="num">{{ t.latest|pln }}</td><td class="num">{{ t.n }}</td>
        {% if t.change_pct is not none %}
        <td class="num {{ 'down' if t.change_pct < 0 else 'up' if t.change_pct > 0 else '' }}">{{ '%+.1f'|format(t.change_pct)|replace('-', '−') }}%</td>
        {% else %}<td class="num muted">—</td>{% endif %}
        <td>{{ t.since }}</td><td>{{ t.spark or '—' }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}<div class="empty">Trend pojawi się po kolejnych skanach — mediany modeli są zapisywane od {{ trend[0].since if trend else run_date }}.</div>{% endif %}

  <h2>🔻 Deprecjacja modeli</h2>
  {% if deprec %}
  <p class="sub" style="margin:-6px 0 12px">Mediana ceny brutto po roczniku oraz szacowany spadek ceny za rok wieku i za 10&nbsp;tys.&nbsp;km (regresja na aktywnych ofertach modelu, min. 8 ofert). Wykres: cena vs przebieg, kolor = rocznik.</p>
  <div class="deps">
  {% for v in deprec %}{% set dep = v.dep %}
    <div class="dep">
      <h3>{{ dep.model }} <span class="count">{{ dep.n }}</span></h3>
      {% if dep.per_year_pln is not none or dep.per_10k_km_pln is not none %}
      <p class="fit">
        {% if dep.per_year_pln is not none %}<b>−{{ dep.per_year_pln|pln }}</b> / rok{% endif %}
        {% if dep.per_year_pln is not none and dep.per_10k_km_pln is not none %} · {% endif %}
        {% if dep.per_10k_km_pln is not none %}<b>−{{ dep.per_10k_km_pln|pln }}</b> / 10&nbsp;tys.&nbsp;km{% endif %}
        <small class="muted">R² {{ '%.2f'|format(dep.r2) }}</small></p>
      {% else %}<p class="fit muted">Za mało ofert na wiarygodną regresję.</p>{% endif %}
      <div class="dep-body">
        {{ v.scatter }}
        <table class="yrs">
          <thead><tr><th class="nosort">Rocznik</th><th class="nosort num">Ofert</th><th class="nosort num">Mediana</th><th class="nosort num">Przebieg</th><th class="nosort num">Vs młodszy</th></tr></thead>
          <tbody>
          {% for y in dep.years %}
            <tr><td><i class="dot" style="background:{{ v.colors[y.year] }}"></i>{{ y.year }}</td><td class="num">{{ y.n }}</td><td class="num">{{ y.price|pln }}</td>
              <td class="num">{{ y.mileage_km|km }}</td>
              <td class="num {{ 'up' if y.step_pct is not none and y.step_pct > 0 else 'down' if y.step_pct is not none and y.step_pct < 0 else '' }}">{{ ('%+.0f'|format(y.step_pct)|replace('-', '−') ~ '%') if y.step_pct is not none else '—' }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endfor %}
  </div>
  {% else %}<div class="empty">Za mało ofert z rocznikiem, przebiegiem i ceną.</div>{% endif %}

  <h2>⏱ Czas ekspozycji</h2>
  {% if exposure %}
  <p class="sub" style="margin:-6px 0 12px">Mediana dni, przez które oferta jest widoczna. „Zniknęły” to oferty, których nie ma już w źródłach (sprzedane lub wycofane) — liczone od zapisanych skanów, więc krótko po starcie dane są zaniżone.</p>
  <div class="tbl-wrap"><table class="trend">
    <thead><tr><th class="nosort">Model</th><th class="nosort num">Aktywne</th><th class="nosort num">Mediana wieku</th>
      <th class="nosort num">Zniknęły</th><th class="nosort num">Mediana do zniknięcia</th></tr></thead>
    <tbody>
    {% for e in exposure %}
      <tr><td><b>{{ e.model }}</b></td><td class="num">{{ e.active_n }}</td>
        <td class="num">{{ (e.active_median_days ~ ' d') if e.active_median_days is not none else '—' }}</td>
        <td class="num">{{ e.gone_n }}</td>
        <td class="num">{{ (e.gone_median_days ~ ' d') if e.gone_median_days is not none else '—' }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}<div class="empty">Brak danych.</div>{% endif %}

  <h2>⚠️ Do weryfikacji <span class="count">{{ d.uncertain|length }}</span></h2>
  {% if d.uncertain %}
  <p class="sub" style="margin:-6px 0 12px">Nie udało się jednoznacznie stwierdzić, że to auto elektryczne (np. Kia Niro bez podanego rodzaju paliwa).</p>
  <div class="tbl-wrap"><table class="offers">
    {{ thead() }}
    <tbody>{% for o in d.uncertain %}{{ offer_row(o) }}{% endfor %}</tbody>
  </table></div>
  {% else %}<div class="empty">Brak ofert wymagających weryfikacji.</div>{% endif %}

  <h2>Zniknęły od ostatniego skanu <span class="count">{{ d.gone|length }}</span></h2>
  <details>
    <summary>Pokaż listę ({{ d.gone|length }})</summary>
    {% if d.gone %}
    <div class="tbl-wrap" style="box-shadow:none"><table>
      <thead><tr><th class="nosort">Pojazd</th><th class="nosort num">Rok</th><th class="nosort num">Ostatnia cena</th><th class="nosort num" title="Dni od pojawienia się oferty do ostatniego skanu, w którym była widoczna">Była w ofercie</th><th class="nosort">Źródło</th><th class="nosort"></th></tr></thead>
      <tbody>
      {% for x in d.gone %}{% set o = x.offer %}
        <tr><td class="wrap"><b>{{ o.brand }} {{ o.model_matched }}</b><br><small>{{ o.title_raw }}</small></td>
          <td class="num">{{ o.year or '—' }}</td><td class="num">{{ price(o) }}</td>
          <td class="num">{{ age_gone(o)[0] }} d</td>
          <td>{{ source_names.get(o.source, o.source) }}</td>
          <td><a href="{{ o.url }}" target="_blank" rel="noopener noreferrer">link ↗</a></td></tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% else %}<p class="muted">Nic nie zniknęło.</p>{% endif %}
  </details>

  {% if alt_links %}
  <h2>Alternatywnie: szukaj sam</h2>
  <p class="sub" style="margin:-6px 0 12px">Tych portali nie skanujemy — linki otwierają gotowe wyszukiwania (auta elektryczne{% if alt_max_price %}, cena do {{ alt_max_price|pln }}{% endif %}). Ceny w ogłoszeniach mogą być netto lub brutto, sprawdź w treści.</p>
  <div class="tbl-wrap"><table>
    <tbody>
    {% for label, links in alt_links %}
      <tr><td style="width:260px"><b>{{ label }}</b></td>
        <td>{% for name, url in links %}<a class="btn" href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ name }} ↗</a> {% endfor %}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  <footer>Wygenerowano przez EV Radar · {{ run_date }} {{ run_time }}</footer>
</main>

<script>
(function () {
  var stale = document.getElementById('stale');
  var hours = (Date.now() - new Date(stale.dataset.run).getTime()) / 36e5;
  if (hours > 36) {
    stale.textContent = '⚠ Raport ma ' + Math.floor(hours / 24) + ' d. — codzienny skan może się nie wykonywać (sprawdź zadanie "EVRadar Daily Report").';
    stale.hidden = false;
  }
})();
(function () {
  var table = document.getElementById('offers');
  var rows = Array.prototype.slice.call(table.tBodies[0].rows);
  var allRows = Array.prototype.slice.call(document.querySelectorAll('table.offers tbody tr'));
  var q = document.getElementById('q');
  var counter = document.getElementById('visible-count');
  var noMatch = document.getElementById('no-match');
  var active = {};
  var KEY = 'evradar:marks';
  var marks = {};
  try { marks = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { marks = {}; }
  var onlyFav = document.getElementById('only-fav');
  var showDismissed = document.getElementById('show-dismissed');

  function save() { try { localStorage.setItem(KEY, JSON.stringify(marks)); } catch (e) {} }
  function pressed(b) { return b.getAttribute('aria-pressed') === 'true'; }

  function apply() {
    var needle = q.value.trim().toLowerCase(), shown = 0, favs = 0, hid = 0;
    allRows.forEach(function (tr) {
      var mark = marks[tr.dataset.id] || '';
      tr.classList.toggle('fav', mark === 'fav');
      tr.classList.toggle('dismissed', mark === 'hide');
    });
    rows.forEach(function (tr) {
      var mark = marks[tr.dataset.id] || '';
      tr.classList.toggle('fav', mark === 'fav');
      tr.classList.toggle('dismissed', mark === 'hide');
      if (mark === 'fav') favs++;
      if (mark === 'hide') hid++;
      var ok = !needle || tr.dataset.search.indexOf(needle) !== -1;
      if (mark === 'hide' && !pressed(showDismissed)) ok = false;
      if (pressed(onlyFav) && mark !== 'fav') ok = false;
      Object.keys(active).forEach(function (g) {
        var set = active[g];
        var vals = (tr.dataset[g + 'All'] || tr.dataset[g]).split('|');
        if (ok && set.length && !vals.some(function (v) { return set.indexOf(v) !== -1; })) ok = false;
      });
      if (ok && !inRanges(tr)) ok = false;
      tr.classList.toggle('hidden', !ok);
      if (ok) shown++;
    });
    counter.textContent = shown;
    document.getElementById('fav-count').textContent = favs;
    document.getElementById('dismissed-count').textContent = hid;
    noMatch.hidden = shown !== 0;
  }

  [onlyFav, showDismissed].forEach(function (b) {
    b.addEventListener('click', function () { b.setAttribute('aria-pressed', !pressed(b)); apply(); });
  });
  document.addEventListener('click', function (e) {
    var b = e.target.closest('table.offers button[data-act]');
    if (!b) return;
    var id = b.closest('tr').dataset.id, want = b.dataset.act;
    if (marks[id] === want) delete marks[id]; else marks[id] = want;
    save();
    apply();
  });

  q.addEventListener('input', apply);

  function numOf(v) { return v === '' || v == null ? NaN : parseFloat(v); }
  var RANGES = [
    { id: 'price', step: 5000, mode: 'max', get: function (tr) { var g = numOf(tr.dataset.gross); return isNaN(g) ? numOf(tr.dataset.net) : g; },
      fmt: function (v) { return v.toLocaleString('pl-PL') + '\u00a0z\u0142'; } },
    { id: 'km', step: 5000, mode: 'max', get: function (tr) { return numOf(tr.dataset.km); },
      fmt: function (v) { return v.toLocaleString('pl-PL') + '\u00a0km'; } },
    { id: 'year', step: 1, mode: 'min', get: function (tr) { return numOf(tr.dataset.year); },
      fmt: function (v) { return String(v); } }
  ];
  RANGES.forEach(function (r) {
    r.input = document.getElementById('r-' + r.id);
    r.out = document.getElementById('o-' + r.id);
    var vals = rows.map(r.get).filter(function (v) { return !isNaN(v); });
    if (!vals.length) { r.input.parentNode.hidden = true; r.off = true; return; }
    r.lo = Math.floor(Math.min.apply(null, vals) / r.step) * r.step;
    r.hi = Math.ceil(Math.max.apply(null, vals) / r.step) * r.step;
    if (r.lo === r.hi) { r.input.parentNode.hidden = true; r.off = true; return; }
    r.input.min = r.lo; r.input.max = r.hi; r.input.step = r.step;
    r.reset = function () { r.input.value = r.mode === 'max' ? r.hi : r.lo; r.out.textContent = r.fmt(parseFloat(r.input.value)); };
    r.reset();
    r.input.addEventListener('input', function () { r.out.textContent = r.fmt(parseFloat(r.input.value)); apply(); });
  });
  function inRanges(tr) {
    for (var i = 0; i < RANGES.length; i++) {
      var r = RANGES[i];
      if (r.off) continue;
      var limit = parseFloat(r.input.value);
      if (r.mode === 'max' ? limit >= r.hi : limit <= r.lo) continue;
      var v = r.get(tr);
      if (isNaN(v) || (r.mode === 'max' ? v > limit : v < limit)) return false;
    }
    return true;
  }
  document.getElementById('reset-ranges').addEventListener('click', function () {
    RANGES.forEach(function (r) { if (!r.off) r.reset(); });
    apply();
  });

  Array.prototype.forEach.call(document.querySelectorAll('.chips'), function (box) {
    var group = box.dataset.group;
    active[group] = [];
    box.addEventListener('click', function (e) {
      var b = e.target.closest('.chip');
      if (!b) return;
      var on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', on);
      var v = b.dataset.value, list = active[group], i = list.indexOf(v);
      if (on && i === -1) list.push(v); else if (!on && i !== -1) list.splice(i, 1);
      apply();
    });
  });

  Array.prototype.forEach.call(document.querySelectorAll('table.offers'), function (tbl) {
    var body = tbl.tBodies[0], list = Array.prototype.slice.call(body.rows);
    Array.prototype.forEach.call(tbl.tHead.rows[0].cells, function (th, idx) {
      if (th.classList.contains('nosort')) return;
      th.addEventListener('click', function () {
        var dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        Array.prototype.forEach.call(th.parentNode.cells, function (c) { c.removeAttribute('aria-sort'); });
        th.setAttribute('aria-sort', dir);
        var num = th.dataset.type === 'num', mul = dir === 'ascending' ? 1 : -1;
        list.sort(function (a, b) {
          var x = a.cells[idx].dataset.s, y = b.cells[idx].dataset.s;
          if (num) return (parseFloat(x) - parseFloat(y)) * mul;
          return x.localeCompare(y, 'pl') * mul;
        });
        list.forEach(function (tr) { body.appendChild(tr); });
      });
    });
  });

  document.addEventListener('error', function (e) {
    var t = e.target;
    if (t && t.tagName === 'IMG') {
      if (t.parentNode.classList.contains('mini')) { t.remove(); } else { t.parentNode.textContent = 'brak zdjęcia'; }
    }
  }, true);

  apply();
})();
</script>
</body>
</html>
